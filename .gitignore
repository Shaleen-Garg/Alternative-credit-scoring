# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Data
data/raw/*
data/interim/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/processed/splits/
!data/processed/splits/*.csv
!data/processed/splits/README.md

# Large data files
*.csv
*.csv.gz
*.zip
*.parquet
*.feather
*.pkl
*.pickle
!data/processed/splits/*.csv

# Databases
*.db
*.sqlite
*.sqlite3

# Detailed generated outputs are rebuilt by the analysis modules.
reports/figures/
reports/tables/

# Curated, shareable results.
reports/results/*
!reports/results/*.csv
!reports/results/*.png

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
